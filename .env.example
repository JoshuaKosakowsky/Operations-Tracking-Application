# Copy to .env locally; never commit populated settings.
# Environment variables override .env. No secrets are required for local records.
APP_ENV=local
DATABASE_URL=
TEAM_ACCESS_CODE=
APP_ORIGIN=
# Set only when identifying an exact exported source commit.
BUILD_SHA=
# Optional course text model. Fill all three to enable AI; key stays server-side.
# Port 9000 is reserved exclusively for Hermes. Use fictional data: 9001 is HTTP.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
